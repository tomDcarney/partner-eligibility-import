{
  "name": "partner-eligibility-import",
  "version": "1.0.0",
  "description": "Generic, config-driven importer for partner eligibility CSV files with SQLite storage and HTTP lookup.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "import": "tsx src/cli.ts",
    "serve": "tsx src/http/server.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "csv-parse": "^5.5.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
